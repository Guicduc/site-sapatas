{
  "name": "site-sapatas",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test",
    "start": "next start",
    "test:cookie-consent": "node --test test/cookie-consent.test.js",
    "export:gh": "powershell -ExecutionPolicy Bypass -File Produtos/scripts/run-gh-export-variations.ps1",
    "product:check": "node Produtos/scripts/product-check.mjs",
    "product:prepare-data": "npm run export:gh && npm run slice:dataset && npm run pricing:build-data",
    "product:validate": "npm test && npm run product:check && npm run pricing:check && npm run pricing:audit && npm run build",
    "slice:dataset": "node Produtos/scripts/orca-slice-dataset.mjs",
    "slice:check": "node Produtos/scripts/orca-slice-dataset.mjs --check",
    "cost:build": "node Produtos/scripts/build-production-cost-data.mjs",
    "pricing:build-data": "npm run cost:build && node Produtos/scripts/build-site-pricing-data.mjs",
    "pricing:model-check": "node Produtos/scripts/audit-pricing-models.mjs --check",
    "pricing:coverage": "node Produtos/scripts/audit-pricing-coverage.mjs --check",
    "pricing:check": "node Produtos/scripts/diagnose-pricing-sweeps.mjs --check",
    "pricing:audit": "npm run pricing:model-check && node Produtos/scripts/audit-pricing-workflow.mjs --check && npm run pricing:coverage",
    "invoice:audit": "node scripts/audit-focus-nfe.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "next": "16.3.4",
    "pg": "^8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
